define timeperiod {
    timeperiod_name p1-24x7
    alias           Project 1 always-on period
    sunday          00:00-24:00
    monday          00:00-24:00
    tuesday         00:00-24:00
    wednesday       00:00-24:00
    thursday        00:00-24:00
    friday          00:00-24:00
    saturday        00:00-24:00
}

define contact {
    contact_name                    p1-lab-operator
    alias                           Project 1 lab operator
    email                           {{ nagios_contact_email }}
    host_notification_period        p1-24x7
    host_notification_options       d,u,r
    host_notification_commands      p1_notify_host_by_email
    service_notification_period     p1-24x7
    service_notification_options    w,u,c,r
    service_notification_commands   p1_notify_service_by_email
}

define contactgroup {
    contactgroup_name p1-ops
    alias             Project 1 operations
    members           p1-lab-operator
}
